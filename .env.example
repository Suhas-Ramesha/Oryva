# SMTP email delivery for the contact / waitlist / FORGE forms.
# Copy this file to .env.local and fill in the values (see README/setup).
# SMTP_USER, SMTP_PASSWORD, FORMS_FROM_EMAIL and FORMS_TO_EMAIL are required —
# if any is missing, the forms return a delivery error.

# --- Gmail / Google Workspace SMTP ---
# The full email address you send from (e.g. contact@oryvaai.com).
SMTP_USER=contact@oryvaai.com

# A Google "App Password" (16 chars), NOT your normal login password.
# Requires 2-Step Verification enabled: Google Account → Security →
# 2-Step Verification → App passwords. Paste it here without spaces.
SMTP_PASSWORD=

# Optional — defaults to Gmail. Only set these for a non-Gmail provider.
# Port 465 = SSL (secure), 587 = STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# The "from" address shown to recipients. For Gmail this must be the same
# account as SMTP_USER (or a verified "Send mail as" alias on it).
# Format: "Display Name <address@domain>".
FORMS_FROM_EMAIL=ORYVA AI <contact@oryvaai.com>

# Where form submissions are delivered (your inbox).
FORMS_TO_EMAIL=contact@oryvaai.com
