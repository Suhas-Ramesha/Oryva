# Resend email delivery for the contact / waitlist / FORGE forms.
# Copy this file to .env.local and fill in the values (see README/setup).
# All three are required — if any is missing, the forms return a delivery error.

# API key from https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=

# The "from" address. The DOMAIN must be verified in Resend
# (Resend → Domains). Format: "Display Name <address@your-domain>".
FORMS_FROM_EMAIL=ORYVA AI <contact@oryvaai.com>

# Where form submissions are delivered (your inbox).
FORMS_TO_EMAIL=contact@oryvaai.com
